{
  "extends": "./tsconfig.cli.json",
  // Shared tests are checked by tsconfig.node.json; shared production code stays in every project.
  "exclude": [
    "../src/shared/**/*.test.ts",
    "../src/shared/**/*.test.tsx",
    "../src/shared/**/*.spec.ts",
    "../src/shared/**/*.spec.tsx"
  ],
  "compilerOptions": {
    "module": "Node20",
    "moduleResolution": "node16"
  }
}
